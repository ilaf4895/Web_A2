<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
    <h1>Admin Dashboard</h1>
    <h2>Add New Course</h2>
    <form id="add-course-form">
        <input type="text" id="new-course-name" placeholder="Course Name" required>
        <input type="text" id="new-course-code" placeholder="Course Code" required>
        <input type="text" id="new-department" placeholder="Department" required>
        <input type="text" id="new-schedule-days" placeholder="Days of Week (e.g. Monday, Wednesday)" required>
        <input type="text" id="new-schedule-time" placeholder="Course Time" required>
        <input type="number" id="new-seats-available" placeholder="Seats Available" required>
        <button type="submit">Add Course</button>
    </form>
    <h2>Courses</h2>
    <ul id="course-list"></ul>
    <script src="/public/js/admin/dashboard.js"></script>
</body>
</html>
